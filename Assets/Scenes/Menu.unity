  m_text: "\u2022<indent=20>Heavy and slow, with a short hop</indent>\n\u2022<indent=20>Smashes brick, presses periods, pushes heavy words</indent>\n\u2022<indent=20>Squashes an enemy by landing on it</indent>\n\u2022<indent=20>Grow in mid-air to slam: knocks out enemies beside you</indent>\n\u2022<indent=20>Sinks to the bottom of ink and walks into the wind</indent>\n\u2022<indent=20>Snaps hyphens, breaks commas, shoots bigger asterisks</indent>"
  m_isRightToLeft: 0
