{
  "name": "lowercase-uppercase-levels",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Files here are served as they are; everything else (/api/levels) reaches the Worker.
  "assets": { "directory": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lowercase-uppercase-levels",
      "database_id": "8492507a-8fdb-4836-8f08-31848f90d413"
    }
  ],
  // Uploads per visitor. Periods can only be 10 or 60 seconds. The namespace id is per account, so it differs
  // from Shift Register's to keep the two counters apart.
  "ratelimits": [
    { "name": "UPLOADS", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
